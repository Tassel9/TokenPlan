# TokenPlan 环境变量示例
# ─────────────────────────────────────────────────────────────────────────────
# 只有 1 项必填；其余变量全部有代码默认值。
#   · 容器外直接跑 Python（backend/cli.py / uvicorn --app-dir backend）：请填写下面「本地运行」的地址
#   · 用 docker compose 起应用：compose 会注入容器内地址，下面这些值会被覆盖
# 完整变量清单（80+ 项）与默认值：docs/configuration.md
# 填完先自检：python backend/cli.py doctor
# ─────────────────────────────────────────────────────────────────────────────

# ── 必填 ─────────────────────────────────────────────────────────────────────
# platform.deepseek.com 获取；留空则启动直接报错
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── 本地运行（容器外）────────────────────────────────────────────────────────
# RabbitMQ / ChromaDB 默认使用容器内主机名；宿主机运行时需显式覆盖。
SESSION_DB_PATH=./data/session/conversations.sqlite3
BUSINESS_DB_PATH=./data/business/business.sqlite3
RABBITMQ_URL=amqp://tokenplan:tokenplan123@localhost:5672/
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── 常用可选（注释掉即用括号内默认值）────────────────────────────────────────
# DEEPSEEK_MODEL=deepseek-v4-flash             # 模型名
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# LOG_LEVEL=INFO
# APP_ENV=development                          # 仅当等于 development 时开启 uvicorn 热重载
# LONG_TERM_MEMORY_QUEUE_ENABLED=false         # 默认 true；不想跑 RabbitMQ 时置 false（关闭长期记忆写入）
# MEMORY_ALLOW_EMBEDDED_CHROMA_FALLBACK=true   # 默认 false；没有 ChromaDB 时允许内嵌降级
# TRACE_FINGERPRINT_KEY=change-me-32-bytes     # 默认为空；对外部署前建议设置

# ── 需要更多控制时 ───────────────────────────────────────────────────────────
# 意图候选数 / 置信度阈值 / RAG 重排 / 记忆窗口 / 并发闸门 / Trace 保留天数 等
# 全部可调项与默认值见 docs/configuration.md
#
# 默认在线链路：全标签 Embedding 与 LLM 完整意图树并行，只做一次融合。
# 修改权重或阈值后必须重跑开发集校准与独立冻结评测：
# INTENT_EMBEDDING_TOP_K=6                    # 仅用于诊断展示，不裁剪 LLM 意图树
# INTENT_FUSION_ALPHA=0.10                    # Embedding 权重
# INTENT_CLEAR_THRESHOLD=0.70                 # 达到后允许冻结执行
# INTENT_LOW_THRESHOLD=0.40                   # 中间区间向用户澄清
# INTENT_EMBEDDING_PRELOAD=true
#
# 历史 few-shot / Jev 实现只供离线对照评测，不接入默认在线链路。
