# UrbanOps 环境变量示例
# ─────────────────────────────────────────────────────────────────────────────
# 只有 1 项必填；其余变量全部有代码默认值。
#   · 容器外直接跑 Python（python -m cli / uvicorn）：请填写下面「本地运行」的地址
#   · 用 docker compose 起应用：compose 会注入容器内地址，下面这些值会被覆盖
# 完整变量清单（80+ 项）与默认值：docs/configuration.md
# 填完先自检：python -m cli doctor
# ─────────────────────────────────────────────────────────────────────────────

# ── 必填 ─────────────────────────────────────────────────────────────────────
# platform.deepseek.com 获取；留空则启动直接报错
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── 本地运行（容器外）────────────────────────────────────────────────────────
# RabbitMQ / ChromaDB 默认使用容器内主机名；宿主机运行时需显式覆盖。
SESSION_DB_PATH=./data/session/conversations.sqlite3
BUSINESS_DB_PATH=./data/business/business.sqlite3
RABBITMQ_URL=amqp://tokenplan:tokenplan123@localhost:5672/
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── 常用可选（注释掉即用括号内默认值）────────────────────────────────────────
# DEEPSEEK_MODEL=deepseek-v4-flash             # 模型名
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# LOG_LEVEL=INFO
# APP_ENV=development                          # 仅当等于 development 时开启 uvicorn 热重载
# LONG_TERM_MEMORY_QUEUE_ENABLED=false         # 默认 true；不想跑 RabbitMQ 时置 false（关闭长期记忆写入）
# MEMORY_ALLOW_EMBEDDED_CHROMA_FALLBACK=true   # 默认 false；没有 ChromaDB 时允许内嵌降级
# TRACE_FINGERPRINT_KEY=change-me-32-bytes     # 默认为空；对外部署前建议设置

# ── 需要更多控制时 ───────────────────────────────────────────────────────────
# 意图候选数 / 置信度阈值 / RAG 重排 / 记忆窗口 / 并发闸门 / Trace 保留天数 等
# 全部可调项与默认值见 docs/configuration.md
#
# 以下旧候选数仍受历史评测报告约束；融合策略是新链路，参数须先用开发集
# 校准，再在独立冻结集评测，不能沿用旧报告结论：
# SUPERVISOR_INTENT_CANDIDATE_TOP_N=6
# SUPERVISOR_INTENT_EMBEDDING_CALIBRATION_SCALE=1.0  # 默认恒等映射，不代表已统计校准
# SUPERVISOR_INTENT_EMBEDDING_CALIBRATION_BIAS=0.0
# SUPERVISOR_INTENT_TREE_CALIBRATION_SCALE=1.0       # 两路参数需要分别拟合
# SUPERVISOR_INTENT_TREE_CALIBRATION_BIAS=0.0
# SUPERVISOR_INTENT_FUSION_ALPHA=0.50            # Embedding 权重；修改后必须重跑校准与冻结评测
#
# 可选：将 Jev 作为 Supervisor 第一轮必调的意图识别 Tool。
# 启用前安装 requirements/intent-jev.txt，并在独立数据集上校准 两个阈值。
# SUPERVISOR_INTENT_TOOL_BACKEND=jev             # 默认 disabled
# TYPESAFE_API_KEY=your_typesafe_api_key_here
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# SUPERVISOR_JEV_MODEL=jev-1.13.0                 # 固定版本，避免别名升级改变概率分布
# SUPERVISOR_JEV_CANDIDATE_THRESHOLD=0.20         # 进入 Supervisor 候选集
# SUPERVISOR_JEV_RECOMMENDATION_THRESHOLD=0.80    # Tool 高概率提示，不直接触发执行
# SUPERVISOR_JEV_TIMEOUT_SECONDS=10
