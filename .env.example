# TokenPlan 环境变量示例
# ─────────────────────────────────────────────────────────────────────────────
# 只有 1 项必填；其余变量全部有代码默认值。
#   · 容器外直接跑 Python（backend/cli.py / uvicorn --app-dir backend）：请填写下面「本地运行」的地址
#   · 用 docker compose 起应用：compose 会注入容器内地址，下面这些值会被覆盖
# 完整变量清单（80+ 项）与默认值：docs/configuration.md
# 填完先自检：python backend/cli.py doctor
# ─────────────────────────────────────────────────────────────────────────────

# ── 必填 ─────────────────────────────────────────────────────────────────────
# platform.deepseek.com 获取；留空则启动直接报错
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── 本地运行（容器外）────────────────────────────────────────────────────────
# Redis / ChromaDB 默认使用容器内主机名；宿主机运行时需显式覆盖。
# Redis 保存短期会话与提交状态，ChromaDB 保存长期事实；SQLite 为离线兼容后端。
MEMORY_BACKEND=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your_password
SESSION_DB_PATH=./data/session/conversations.sqlite3
BUSINESS_DB_PATH=./data/business/business.sqlite3
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma
LONG_TERM_MEMORY_FACT_INJECTION=recall
LONG_TERM_MEMORY_ENGINE=mem0_flow

# ── 常用可选（注释掉即用括号内默认值）────────────────────────────────────────
# DEEPSEEK_MODEL=deepseek-v4-flash             # 模型名
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# LOG_LEVEL=INFO
# APP_ENV=development                          # 仅当等于 development 时开启 uvicorn 热重载
# LONG_TERM_MEMORY_ASYNC_ENABLED=true          # 默认 true；进程内后台协程更新长期记忆
# LONG_TERM_MEMORY_EXTRACTION_INTERVAL_TURNS=10 # 每会话累计 10 轮用户消息，一次模型抽取
# LONG_TERM_MEMORY_IDLE_FLUSH_SECONDS=120    # 少轮会话空闲两分钟后提前抽取
# LONG_TERM_MEMORY_EXTRACTION_TOKEN_LIMIT=12000 # 抽取输入预算；按完整轮次切批
# LONG_TERM_MEMORY_CONTEXT_TOKEN_BUDGET=800   # 注入的长期上下文 Token 上限
# LONG_TERM_MEMORY_RECALL_MAX=5              # 最多注入五条相关主题记忆
# LONG_TERM_MEMORY_FACT_TTL_DAYS=180          # 通用用户事实；旧环境字段仍为180天
# LONG_TERM_MEMORY_PREFERENCE_TTL_DAYS=365    # 通用偏好；旧表达/账单字段仍为365天
# LONG_TERM_MEMORY_PLAN_TTL_DAYS=30           # 无明确日期的用户计划
# LONG_TERM_MEMORY_ADVICE_TTL_DAYS=30         # 助手建议独立归属
# LONG_TERM_MEMORY_DECISION_TTL_DAYS=180      # 项目决策
# LONG_TERM_MEMORY_CLEANUP_INTERVAL_S=300       # 每 5 分钟物理清理过期事实，启动时也清理
# SHORT_TERM_TOKEN_LIMIT=6000                  # 约束原文 + 摘要 + 近期对话 + 同会话召回的总 Token 预算
# SESSION_HISTORY_TTL_SECONDS=604800          # 原始归档与约束变更的逻辑保留期，默认7天
# SESSION_HISTORY_MAX_MESSAGES=100            # 原始归档消息上限，含用户问题和对应回答
# SHORT_TERM_RECENT_TURNS=5                    # 超限压缩后保留的最近完整对话轮数
# SESSION_HOT_MEMORY_MAX_MESSAGES=20          # 摘要失败时近期消息的兜底上限，按完整轮次保留
# SHORT_TERM_SUMMARY_TOKEN_LIMIT=1000          # 注入上下文的摘要 Token 子预算（含标题）
# SHORT_TERM_SUMMARY_MAX_TOKENS=2048            # 摘要生成输出上限，含 Tool JSON 与来源字段
# TRACE_FINGERPRINT_KEY=change-me-32-bytes     # 默认为空；对外部署前建议设置

# ── 需要更多控制时 ───────────────────────────────────────────────────────────
# 意图候选数 / 置信度阈值 / RAG 重排 / 记忆窗口 / 并发闸门 / Trace 保留天数 等
# 全部可调项与默认值见 docs/configuration.md
#
# 默认在线链路：全标签 Embedding 与 LLM 完整意图树并行，只做一次融合。
# 修改权重或阈值后必须重跑开发集校准与独立冻结评测：
# INTENT_EMBEDDING_TOP_K=6                    # 仅用于诊断展示，不裁剪 LLM 意图树
# INTENT_FUSION_ALPHA=0.05                    # Embedding 权重；2026-10-04 离线校准
# INTENT_CLEAR_THRESHOLD=0.70                 # 达到后允许冻结执行
# INTENT_LOW_THRESHOLD=0.40                   # 中间区间向用户澄清
# INTENT_EMBEDDING_PRELOAD=true
#
# 历史 few-shot / Jev 实现只供离线对照评测，不接入默认在线链路。
