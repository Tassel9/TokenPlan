    {"id": "none-06", "facts": {"environment.os": "macOS", "environment.ide": "Xcode"}, "query": "你们支持企业采购吗？", "expect": []},
    {"id": "decoy-01", "facts": {"preference.inspection_shift": "夜班"}, "decoy_facts": {"preference.inspection_shift": "白班", "environment.ide": "PyCharm"}, "query": "我的巡检班次偏好是什么？", "expect": [{"key": "preference.inspection_shift", "value": "夜班"}]},
    {"id": "decoy-02", "facts": {"environment.ide": "VS Code"}, "decoy_facts": {"environment.ide": "PyCharm"}, "query": "我用哪个编辑器写代码？", "expect": [{"key": "environment.ide", "value": "VS Code"}]}
  ]
