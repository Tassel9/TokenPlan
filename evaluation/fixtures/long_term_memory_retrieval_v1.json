    {"id": "none-03", "facts": {"environment.ide": "PyCharm", "environment.os": "Windows"}, "query": "我想咨询一下工单撤回流程。", "expect": []},
    {"id": "none-04", "facts": {"preference.inspection_shift": "白班"}, "query": "智慧路灯 L-404 当前是否在线？", "expect": []},
