    {"id": "inspection-shift-03", "facts": {"preference.inspection_shift": "夜班"}, "query": "白班还是夜班更适合我？", "expect": [{"key": "preference.inspection_shift", "value": "夜班"}]},
    {"id": "os-01", "facts": {"environment.os": "macOS", "environment.ide": "VS Code"}, "query": "我平时在什么操作系统上办公？", "expect": [{"key": "environment.os", "value": "macOS"}]},
    {"id": "os-02", "facts": {"environment.os": "Ubuntu"}, "query": "我用的系统是哪个来着？", "expect": [{"key": "environment.os", "value": "Ubuntu"}]},
    {"id": "os-03", "facts": {"environment.os": "Windows", "preference.inspection_shift": "夜班"}, "query": "帮我按我的系统给个命令行建议。", "expect": [{"key": "environment.os", "value": "Windows"}]},
    {"id": "ide-01", "facts": {"environment.ide": "PyCharm", "environment.os": "Windows"}, "query": "我平时用什么开发工具写代码？", "expect": [{"key": "environment.ide", "value": "PyCharm"}]},
    {"id": "ide-02", "facts": {"environment.ide": "Vim"}, "query": "帮我想个编辑器的快捷键方案。", "expect": [{"key": "environment.ide", "value": "Vim"}]},
    {"id": "ide-03", "facts": {"environment.ide": "Neovim", "preference.inspection_shift": "白班"}, "query": "我用的那个命令行编辑器叫什么名字来着？", "expect": [{"key": "environment.ide", "value": "Neovim"}]},
    {"id": "ide-04", "facts": {"environment.ide": "VS Code", "environment.os": "Windows"}, "query": "我的开发环境需要重新配置，用哪个工具？", "expect": [{"key": "environment.ide", "value": "VS Code"}]},
    {"id": "multi-01", "facts": {"environment.os": "Windows", "environment.ide": "PyCharm"}, "query": "我的电脑系统和开发工具，你都记着吗？", "expect": [{"key": "environment.os", "value": "Windows"}, {"key": "environment.ide", "value": "PyCharm"}]},
    {"id": "multi-02", "facts": {"preference.inspection_shift": "白班", "environment.os": "Linux"}, "query": "我的巡检班次和操作系统偏好分别是什么？", "expect": [{"key": "preference.inspection_shift", "value": "白班"}, {"key": "environment.os", "value": "Linux"}]},
    {"id": "multi-03", "facts": {"preference.inspection_shift": "夜班", "environment.ide": "Cursor", "environment.os": "macOS"}, "query": "把我记住的偏好都说一遍。", "expect": [{"key": "preference.inspection_shift", "value": "夜班"}, {"key": "environment.ide", "value": "Cursor"}, {"key": "environment.os", "value": "macOS"}]},
    {"id": "multi-04", "facts": {"preference.inspection_shift": "白班", "environment.ide": "IntelliJ IDEA"}, "query": "我要安排巡检，另外我的 IDE 是哪个？", "expect": [{"key": "preference.inspection_shift", "value": "白班"}, {"key": "environment.ide", "value": "IntelliJ IDEA"}]},
    {"id": "style-01", "facts": {"style.response_length": "简短", "preference.inspection_shift": "夜班"}, "query": "我对回答长度有什么要求？", "expect": []},
